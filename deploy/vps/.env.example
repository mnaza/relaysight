# Copy to .env and set the first two. up.sh fills in the secrets.

# The name that points at this server. Caddy gets its certificate for it, so
# the A record has to exist before the first start.
DOMAIN=vms.example.com
# This server's public IPv4. The gateway offers browsers this address for live
# video and nothing else.
PUBLIC_IP=203.0.113.10

# The owner's login. The password is generated by up.sh on the first run.
ADMIN_EMAIL=admin@localhost
#ADMIN_PASSWORD=
#GATEWAY_TOKEN=

# Test-pattern cameras on the server's own gateway. 0 once real sites report.
DEMO_CAMERAS=3

# TURN, for browsers whose network will not let UDP through to the gateway.
# docs/TURN-DEPLOY.md. Empty means STUN only, which is most networks.
#RTC_TURN_URLS=
#RTC_TURN_SECRET=

# Ports on the host. Leave them unless something else holds 80 and 443.
#HTTP_PORT=80
#HTTPS_PORT=443
#API_PORT=8080
#RTMP_PORT=1935
