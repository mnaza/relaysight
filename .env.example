# Community Core API
API_BIND=0.0.0.0:8080
GATEWAY_TOKEN=demo-local-token
STALE_CAMERA_SECONDS=75
PLUGIN_DIR=plugins.d
DEFAULT_STORAGE_PLUGIN=storage-s3
DEFAULT_AI_PLUGIN=ai-http-adapter
DEFAULT_RETENTION_DAYS=30
# JSON array passed to browser and edge. Add TURN credentials for production/NAT-heavy deployments.
RTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"],"username":"","credential":""}]
RUST_LOG=info

# Plugin-to-core credentials (optional but recommended)
AI_PLUGIN_TOKEN=demo-ai-plugin-token
STORAGE_PLUGIN_TOKEN=demo-storage-plugin-token

# Commercial overlay only. If ENTITLEMENTS_URL is absent the core runs as unlimited Community Self-Hosted.
ENTITLEMENTS_URL=
ENTITLEMENTS_TOKEN=commercial-demo-token
COMMERCIAL_FREE_CAMERA_LIMIT=3
# Comma-separated customer IDs which are paid in the demo commercial control plane.
PAID_CUSTOMERS=

# Edge gateway identity
API_URL=http://localhost:8080
GATEWAY_ID=demo-gateway-01
GATEWAY_TOKEN=demo-local-token
# Optional one-time bootstrap token created by POST /api/v1/enrollments
# ENROLLMENT_TOKEN=...
# 0 = unlimited. A hosted commercial entitlement returned during enrollment overrides this.
CAMERA_LIMIT=0
CUSTOMER_ID=pilot-customer
CUSTOMER_NAME=Pilot customer
SITE_ID=demo-site-madrid
SITE_NAME=Madrid demo
SITE_CITY=Madrid

# Camera discovery/probing
HEARTBEAT_INTERVAL_SECONDS=10
ONVIF_DISCOVERY_SECONDS=3
CAMERA_PROBE_INTERVAL_SECONDS=30
RTSP_PROBE_SECONDS=5
COMMAND_POLL_INTERVAL_SECONDS=1
CAMERA_USERNAME=admin
CAMERA_PASSWORD=change-me
# CAMERA_RTSP_URL=rtsp://192.168.1.50:554/Streaming/Channels/101
CAMERA_NAME=Manual RTSP camera

# AI adapter plugin. Point this at your own model API.
UPSTREAM_AI_URL=
UPSTREAM_AI_TOKEN=
# Local demo only: synthetic bbox output when no upstream model is configured.
SIMULATED_AI=false

# S3-compatible storage example / MinIO dev values
S3_BUCKET=vms
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_EDGE_ENDPOINT=http://localhost:9100
S3_SERVICE_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
