{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "White-label VMS runtime brand configuration",
  "type": "object",
  "required": ["name", "defaultLocale", "supportedLocales", "freeTier", "theme", "gateway"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "legalName": { "type": "string" },
    "logoUrl": { "type": "string" },
    "faviconUrl": { "type": "string" },
    "customCssUrl": { "type": "string" },
    "defaultLocale": { "type": "string", "minLength": 2 },
    "supportedLocales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "freeTier": {
      "type": "object",
      "required": ["cameras", "sites", "requiresCard"],
      "properties": {
        "cameras": { "type": "integer", "minimum": 0 },
        "sites": { "type": "integer", "minimum": 0 },
        "requiresCard": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "theme": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["system", "dark", "light"] },
        "primary": { "type": "string" },
        "accent": { "type": "string" },
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "text": { "type": "string" },
        "muted": { "type": "string" },
        "radius": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "gateway": {
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "apiBaseUrl": { "type": "string" },
        "installCommandTemplate": {
          "type": "string",
          "description": "May use {apiUrl}, {enrollmentToken}, {gatewayId}, {cameraLimit}, {image}."
        }
      },
      "additionalProperties": true
    },
    "contact": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": true
}
